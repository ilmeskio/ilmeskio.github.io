---
// Layout for the full CV: /cv/ (EN) and /it/cv/ (IT).
import Base from "./Base.astro";
import Cv from "../components/Cv.astro";
import LangNav from "../components/LangNav.astro";
import { profile, type Lang } from "../data/cv";
import { likeThis } from "../data/like-this";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const paths = { en: "/cv/", it: "/it/cv/" };
const home = lang === "en" ? "/" : "/it/";
const description = {
  en: `${profile.name} — ${profile.headline.en}. Full CV.`,
  it: `${profile.name} — ${profile.headline.it}. CV completo.`,
}[lang];
---

<Base title={`CV — ${profile.name}`} description={description} lang={lang} alternates={paths} ogImage={`/og/${lang}.png`} home={home}>
  <LangNav slot="nav" lang={lang} {...paths} />

  <Cv lang={lang} />

  <nav slot="footer" aria-label={lang === "en" ? "Other pages" : "Altre pagine"}>
    <a href={lang === "en" ? "/cv/like-this/" : "/it/cv/like-this/"}>{likeThis.link[lang]} →</a>
  </nav>
</Base>
