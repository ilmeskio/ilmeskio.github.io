---
// Layout for the home page: / (EN) and /it/ (IT).
import Base from "./Base.astro";
import Home from "../components/Home.astro";
import LangNav from "../components/LangNav.astro";
import { profile, type Lang } from "../data/cv";
import { likeThis } from "../data/like-this";
import { home } from "../data/home";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const paths = { en: "/", it: "/it/" };
const description = `${profile.name} — ${profile.headline[lang]}. ${home.manifesto[lang]}`;
---

<Base title={profile.name} description={description} lang={lang} alternates={paths} ogImage={`/og/${lang}.png`} home={paths[lang]}>
  <LangNav slot="nav" lang={lang} {...paths} />

  <Home lang={lang} />

  <nav slot="footer" aria-label={lang === "en" ? "Other pages" : "Altre pagine"}>
    <a href={lang === "en" ? "/cv/like-this/" : "/it/cv/like-this/"}>{likeThis.link[lang]} →</a>
  </nav>
</Base>
